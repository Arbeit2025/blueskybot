# Copy to .env locally, or set the same names as GitHub Secrets.
# NEVER commit real values. Use an APP PASSWORD, not the main password.
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional: only for accounts hosted on a non-bsky.social PDS.
# BLUESKY_PDS_URL=https://bsky.social
# Real posting also requires this exact value:
POST_ENABLED=false
